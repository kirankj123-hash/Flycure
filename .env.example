# =============================================================================
# FlyCure Health - Environment Configuration
# Copy this file to .env.local and configure for your environment
# =============================================================================

# API Configuration
# =================
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
API_TIMEOUT_MS=10000

# Authentication (Auth.js / NextAuth.js)
# =======================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-jwt-secret-at-least-32-chars-long-123456789
NEXTAUTH_DEBUG=false

# OIDC Configuration (Auth0, Azure AD, etc.)
# ===========================================
AUTH_OIDC_ISSUER=https://your-auth0-domain.auth0.com
AUTH_OIDC_CLIENT_ID=your-oidc-client-id
AUTH_OIDC_CLIENT_SECRET=your-oidc-client-secret
AUTH_OIDC_SCOPE="openid profile email"

# Security & Rate Limiting
# =========================
RATE_LIMIT_REDIS_URL=redis://localhost:6379
RATE_LIMIT_REQUESTS_PER_MINUTE=60
CSRF_SECRET=your-csrf-secret-at-least-32-chars-long-123456789

# Feature Flags
# =============
# Core Features
NEXT_PUBLIC_FEATURE_BOOKING=false
NEXT_PUBLIC_FEATURE_CHAT=false
NEXT_PUBLIC_FEATURE_REVIEWS=true
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=false
NEXT_PUBLIC_FEATURE_WEB_PUSH=false
NEXT_PUBLIC_FEATURE_SSE=true
NEXT_PUBLIC_FEATURE_PWA=false

# Advanced Features
NEXT_PUBLIC_FEATURE_RECOMMENDATIONS=false
NEXT_PUBLIC_FEATURE_MULTILINGUAL=true
NEXT_PUBLIC_FEATURE_ADVANCED_SEARCH=true

# Medical Features
NEXT_PUBLIC_FEATURE_VIRTUAL_CONSULTATIONS=false
NEXT_PUBLIC_FEATURE_MEDICAL_RECORDS=false
NEXT_PUBLIC_FEATURE_TELEMEDICINE=false

# Financial Features
NEXT_PUBLIC_FEATURE_PRICE_COMPARISON=true
NEXT_PUBLIC_FEATURE_INSURANCE=false
NEXT_PUBLIC_FEATURE_PAYMENT_GATEWAY=false

# Engagement Features
NEXT_PUBLIC_FEATURE_LOYALTY=false
NEXT_PUBLIC_FEATURE_REFERRAL=false

# AI Features
NEXT_PUBLIC_FEATURE_AI_ASSISTANT=false

# Observability (OpenTelemetry)
# ==============================
OTEL_SERVICE_NAME=flycure-frontend
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Web Push Notifications (VAPID Keys)
# ====================================
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@flycure.health

# External Services (Optional)
# =============================
DATABASE_URL=postgresql://user:pass@localhost:5432/flycure
REDIS_URL=redis://localhost:6379

# Monitoring & Logging
# =====================
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true

# =============================================================================
# SECURITY NOTES:
# ===============
# 1. Never commit .env.local to version control
# 2. Use strong, randomly generated secrets in production
# 3. Rotate secrets regularly
# 4. Use environment-specific configurations
# 5. Validate all URLs and secrets before deployment
# =============================================================================
